<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.ciproxy.guest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/ciproxy-guest-start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/var/log/ciproxy-guest.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/ciproxy-guest.log</string>
</dict>
</plist>
