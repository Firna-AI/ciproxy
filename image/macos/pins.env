PACKER_SHA256=3d7e4df8e7e8c21bdf495c4f63ad9189e22540dc8126dee6db791aa8519e8b3a
# The logical size of the sparse VM disk, root_disk_bytes. The free job space
# lives inside it, so the agent does not grow it. The measurement gives the
# free bytes of the built image.
DISK_BYTES=200000000000
