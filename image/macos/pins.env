# SPDX-License-Identifier: Apache-2.0
# Immutable inputs of the macOS image. Run image/check-runner.sh before each
# release. The README of this folder says how each pin was chosen.
IMAGE_ID=macos26-arm64-20261117.0516-runner-2.338.2-xcode-26.6-v1
# Apple's newest full restore image for macOS 26. The build updates the guest
# to MACOS_TARGET_BUILD, the system of the pinned GitHub image.
RESTORE_IMAGE_VERSION=26.6.2
RESTORE_IMAGE_BUILD=25G83
RESTORE_IMAGE_URL=https://updates.cdn-apple.com/2026SummerFCS/fullrestores/140-75212/A2A24B94-1FC1-45A3-93F7-C51B02AF1F4D/UniversalMac_26.6.2_25G83_Restore.ipsw
RESTORE_IMAGE_SHA256=885503b7f4b06609e9a512f2befd40f59730640a3f1233e3892d60affdd51c95
MACOS_TARGET_VERSION=26.7.2
MACOS_TARGET_BUILD=25G332
# The GitHub image that macos-latest names on arm64.
RUNNER_IMAGES_TAG=macos-26-arm64/20261117.0516
RUNNER_IMAGES_COMMIT=6ae22b7fe1e9897ad8220e69f154a603cbd4b0ab
RUNNER_IMAGES_URL=https://codeload.github.com/actions/runner-images/tar.gz/6ae22b7fe1e9897ad8220e69f154a603cbd4b0ab
RUNNER_IMAGES_SHA256=57ea879c0738fce567753f601060ad698f322cc8c6a0006a81fc3f61c897a831
RUNNER_IMAGES_TEMPLATE=images/macos/templates/macOS-26.arm64.anka.pkr.hcl
SOFTWARE_MANIFEST_URL=https://github.com/actions/runner-images/releases/download/macos-26-arm64/20261117.0516/internal.macos-26-arm64.json
SOFTWARE_MANIFEST_SHA256=5a32f143a207c1b8b9fa5c6be9b124f71fb0792396547a9cbd0a70e8d7a1e251
RUNNER_VERSION=2.338.2
RUNNER_URL=https://github.com/actions/runner/releases/download/v2.338.2/actions-runner-osx-arm64-2.338.2.tar.gz
RUNNER_SHA256=25a065af409ffa317ab4d5a3b614dd15fc9c40f2172bc1b35a1b1258e919a388
# XCODE_LINKS selects the Xcode versions of the toolset that the image keeps.
# The default Xcode is below. The checksum is upstream's checksum of Apple's
# archive. The build serves each archive under its upstream name.
XCODE_LINKS=26.6
XCODE_VERSION=26.6
XCODE_BUILD=17F113
XCODE_XIP_NAME=Xcode-26.6+17F113.xip
XCODE_SHA256=3f7e2985a080d6166f178034a76a7e7a24e5e64a31f36772f9a3f55e27c94591
PACKER_VERSION=1.16.2
