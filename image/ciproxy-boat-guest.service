# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=One native Boat ciproxy runner
After=network-online.target docker.service containerd.service
Wants=network-online.target docker.service containerd.service

[Service]
Type=exec
EnvironmentFile=/etc/ciproxy/guest.env
ExecStart=/usr/local/bin/ciproxy-guest --image-id ${IMAGE_ID} sandbox --registration-file /run/ciproxy/registration.json
Restart=no
KillMode=control-group

[Install]
WantedBy=multi-user.target
