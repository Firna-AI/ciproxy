---
// An icon of the mockups, drawn in the text colour. Without a label, the icon
// is decoration and screen readers skip it. With a label, it is an image with
// that name, such as the check of an included feature.

import { icons, type IconName } from "./icons.ts";

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const {
  name,
  size = 16,
  strokeWidth = 2,
  class: className,
  label,
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["icon", className]}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={icons[name]}
/>
