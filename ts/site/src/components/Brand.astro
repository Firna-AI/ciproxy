---
// The ciproxy wordmark, after the brand of the mockups: the mark of
// BrandMark.astro and the name, in the text colour.

import BrandMark from "./BrandMark.astro";
---

<span class="brand">
  <BrandMark />
  <span class="brand-word">ciproxy</span>
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--c-ink);
  }

  .brand-word {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 20px;
  }
</style>
