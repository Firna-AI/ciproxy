---
// A legal page of ciproxy.dev, the terms of service or the privacy policy,
// after the legal mockups: the title with the effective date, the switch
// between the two pages, "On this page" on a wide window, and the sections
// with their paragraphs. After its paragraphs, the data retention of the
// privacy policy shows the limits that docs/protocol/security-data.md decides.

import {
  historyWindows,
  legalPageOrder,
  legalPages,
  retentionId,
  retentionRows,
  type LegalPageKey,
} from "../../data/legal.ts";
import Section from "../marketing/Section.astro";
import SectionHead from "../marketing/SectionHead.astro";
import "./legal.css";

interface Props {
  page: LegalPageKey;
  /** The date from which the text applies. The owner sets it. */
  effectiveDate: string;
}

const { page, effectiveDate } = Astro.props;
const { title, sections } = legalPages[page];
---

<Section class="legal-top">
  <SectionHead
    page
    eyebrow="Legal"
    title={title}
    lead={`Effective date: ${effectiveDate}`}
  />
  <nav class="legal-switch" aria-label="Legal pages">
    {legalPageOrder.map((key) => (
      <a
        href={legalPages[key].href}
        class:list={["legal-switch-link", { "is-active": key === page }]}
        aria-current={key === page ? "page" : undefined}
      >
        {legalPages[key].title}
      </a>
    ))}
  </nav>
</Section>
<Section class="legal-body">
  <div class="legal-grid">
    <nav class="legal-toc" aria-label="On this page">
      <p class="legal-toc-title">On this page</p>
      <ul class="legal-toc-list">
        {sections.map((section) => (
          <li>
            <a href={`#${section.id}`} class="legal-toc-link">
              {section.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <article class="legal-article">
      {sections.map((section) => (
        <section class="legal-section">
          <h2 id={section.id} class="legal-h2">
            {section.title}
          </h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {page === "privacy" && section.id === retentionId && (
            <>
              <div class="legal-table-frame">
                <table class="legal-table">
                  <thead>
                    <tr>
                      <th scope="col">Data</th>
                      <th scope="col">Kept for</th>
                    </tr>
                  </thead>
                  <tbody>
                    {retentionRows.map((row) => (
                      <tr>
                        <td>{row.data}</td>
                        <td>{row.kept}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p>
                Each plan shows only its own job history: {historyWindows()}.
              </p>
            </>
          )}
        </section>
      ))}
    </article>
  </div>
</Section>
