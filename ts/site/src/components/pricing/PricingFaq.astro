---
// The common questions of the pricing page: what a start is, what counts as
// a machine, what happens past a limit, who pays for overflow, how to cancel,
// and, last, how the landing page counts its saving.

import { savingId } from "../../data/cost-claim.ts";
import { formatCount } from "../../data/format.ts";
import { sitePages } from "../../data/site.ts";
import { tiers } from "../../data/tiers.ts";
import Section from "../marketing/Section.astro";
import SectionHead from "../marketing/SectionHead.astro";
import SavingCalculation from "./SavingCalculation.astro";
import "./pricing-faq.css";

const faqs: readonly { question: string; answer: string }[] = [
  {
    question: "What is a start?",
    answer:
      "A start is one job that a ciproxy runner takes, on your machine or on Boat, whatever its result. A re-run is a new start. A warm runner that waits without a job is not a start.",
  },
  {
    question: "What counts as an own machine?",
    answer:
      "Every machine that is registered to your workspace, also while it is offline. Remove a machine in the dashboard to free its place.",
  },
  {
    question: "What happens when I pass a limit?",
    answer: `Your jobs keep running. The dashboard shows a warning and offers the plan or add-on that covers your use, such as ${formatCount(tiers.team.starts)} starts on ${tiers.team.name}. You decide when to change; ciproxy adds no charges by itself.`,
  },
  {
    question: "Who pays for overflow?",
    answer:
      "You pay Boat directly. Overflow runners start in your own Boat account, which bills by the second. Set a monthly spend limit in ciproxy; at the limit, jobs wait for a free slot on your machines.",
  },
  {
    question: "How do I cancel?",
    answer:
      "Open Plan and usage in the dashboard and manage your plan in the Stripe customer portal. A move to Free takes effect at the end of the paid period, and your jobs keep running.",
  },
];
---

<Section id="questions">
  <div class="faq">
    <SectionHead title="Questions">
      <Fragment slot="lead">
        Plans, limits, and billing in short. The
        <a href={sitePages.docs} class="text-link">
          docs
        </a>{" "}
        have the rest.
      </Fragment>
    </SectionHead>
    <dl class="faq-list">
      {faqs.map((faq) => (
        <div class="faq-item">
          <dt class="faq-question">{faq.question}</dt>
          <dd class="faq-answer">{faq.answer}</dd>
        </div>
      ))}
      <div id={savingId} class="faq-item">
        <dt class="faq-question">How do you calculate the saving?</dt>
        <dd class="faq-answer">
          <SavingCalculation />
        </dd>
      </div>
    </dl>
  </div>
</Section>
