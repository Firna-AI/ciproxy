# Send only the Rust workspace inputs. Operator files stay outside the context.
**
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!crates/
!crates/**/
!crates/**/Cargo.toml
!crates/**/build.rs
!crates/**/src/**/*.rs
!crates/**/tests/**/*.rs
!crates/**/migrations/**/*.sql
!crates/**/migrations/**/*.toml
!xtask/
!xtask/Cargo.toml
!xtask/src/
!xtask/src/**/*.rs

# These exclusions apply even inside an allowed source directory.
**/.context/**
**/.git/**
**/.cargo/**
**/.docker/**
**/.aws/**
**/.ssh/**
**/target/**
**/node_modules/**
**/dist/**
**/.expo/**
**/.astro/**
**/mokly-generated/**
**/.mokly-export-reservations/**
**/private/**
**/secrets/**
**/credentials/**
**/.env
**/.env.*
**/*.env
**/*credentials*.json
**/*docker-config*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
